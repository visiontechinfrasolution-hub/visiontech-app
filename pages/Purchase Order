# --- 5. ITEM MASTER ---
elif menu == "Item Master":
    st.header("Item Master Registration")
    with st.form("i_form", clear_on_submit=True):
        desc = st.text_input("Item Description")
        rate = st.number_input("Default Rate", min_value=0.0)
        c1, c2 = st.columns(2)
        with c1: cgst_p = st.number_input("CGST %", value=9.0)
        with c2: sgst_p = st.number_input("SGST %", value=9.0)
