# --- 7. CREATE PURCHASE ORDER ---
elif menu == "Create PO":
    st.title("Purchase Order Generator")

    # Data Fetching
    vendors = supabase.table("vendors").select("*").execute().data
    items_list = supabase.table("items_master").select("*").execute().data
    team_list = supabase.table("allowed_users").select("name").execute().data

    col1, col2 = st.columns(2)
    with col1:
        po_no = st.text_input("PO Number", value=get_next_po_number())
        v_choice = st.selectbox("Select Vendor", ["Select"] + [v['name'] for v in vendors])
        selected_v = next((v for v in vendors if v['name'] == v_choice), None)
        v_gst = st.text_input("Vendor GST", value=selected_v['gst_number'] if selected_v else "", disabled=True)
    
    with col2:
        po_date = st.date_input("PO Date", datetime.date.today())
        h_team = st.selectbox("Handover Team", [t['name'] for t in team_list])
        v_addr = st.text_area("Vendor Address", value=selected_v['address'] if selected_v else "", disabled=True)

    st.divider()
    
    # Material Selection
    st.subheader("Add Material")
    selected_item_name = st.selectbox("Select Item", [""] + [i['description'] for i in items_list])
    item_details = next((i for i in items_list if i['description'] == selected_item_name), None)
    
    cq, cr, cb = st.columns([1,1,1])
    with cq: qty = st.number_input("Qty", min_value=1)
    with cr: price = st.number_input("Price", value=float(item_details['rate']) if item_details else 0.0)
    
    if 'po_items' not in st.session_state: st.session_state.po_items = []

    if cb.button("Add Item", use_container_width=True):
        if item_details:
            basic = qty * price
            c_amt = (basic * float(item_details['cgst_pct'])) / 100
            s_amt = (basic * float(item_details['sgst_pct'])) / 100
            st.session_state.po_items.append({
                "Description": selected_item_name, "Qty": qty, "Price": price,
                "Basic": basic, "CGST": c_amt, "SGST": s_amt, "Total": basic + c_amt + s_amt
            })

    if st.session_state.po_items:
        df_po = pd.DataFrame(st.session_state.po_items)
        st.table(df_po)
        
        g_total = df_po['Total'].sum()
        words = num2words(g_total, lang='en_IN').title() + " Rupees Only"
        st.metric("Grand Total", f"₹ {g_total:,.2f}")

        if st.button("Save & Share PO"):
            po_data = {
                "po_number": po_no, "vendor_name": v_choice, "vendor_gst": v_gst,
                "handover_team": h_team, "items": st.session_state.po_items,
                "grand_total": float(g_total), "amount_in_words": words
            }
            supabase.table("purchase_orders").insert(po_data).execute()
            st.success("PO Saved in Supabase!")
            
            # Reset Session for next PO
            # st.session_state.po_items = []
            
            # WhatsApp Option
            wa_url = f"https://wa.me/?text=Hello {v_choice}, Please find PO {po_no} from Visiontech."
            st.link_button("Share on WhatsApp", wa_url)
