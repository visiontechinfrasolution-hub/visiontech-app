# --- 2. SITE MASTER FORM (LOGIC 1 INCLUDED) ---
@st.dialog("🏗️ Site Master Form")
def site_form_dialog(edit_data=None):
    is_edit = edit_data is not None
    with st.form("site_master_form", clear_on_submit=True):
        f1, f2, f3 = st.columns(3)
        with f1:
            p_id = st.text_input("Project ID", value=str(edit_data.get('project_id', '')) if is_edit else "")
            s_id = st.text_input("Site ID", value=str(edit_data.get('site_id', '')) if is_edit else "")
            s_name = st.text_input("Site Name", value=str(edit_data.get('site_name', '')) if is_edit else "")
        with f2:
            clstr = st.text_input("Cluster", value=str(edit_data.get('cluster', '')) if is_edit else "")
            a_date = st.date_input("Allocation Date")
            w_desc = st.text_area("Work Description", value=str(edit_data.get('work_description', '')) if is_edit else "")
        with f3:
            p_no = st.text_input("PO No", value=str(edit_data.get('po_no', '')) if is_edit else "")
            p_amt = st.number_input("PO Amount", min_value=0.0, value=float(edit_data.get('po_amt', 0.0)) if is_edit else 0.0)
            
            # LOGIC 1: Auto 40% Calculation
            payable_amt_calc = p_amt * 0.40
            st.write(f"**Payable (40%): ₹ {payable_amt_calc:,.2f}**")
            
            wcc_no = st.text_input("WCC Number", value=str(edit_data.get('wcc_number', '')) if is_edit else "")
            status_list = ["Pending", "Approved", "Rejected"]
            current_st = edit_data.get('wcc_status', 'Pending') if is_edit else 'Pending'
            wcc_st = st.selectbox("WCC Status (Proceed)", status_list, index=status_list.index(current_st) if current_st in status_list else 0)

        if st.form_submit_button("Save Record", use_container_width=True):
            payload = {
                "project_id": p_id, "site_id": s_id, "site_name": s_name,
                "cluster": clstr, "allocation_date": str(a_date),
                "work_description": w_desc, "po_no": p_no, 
                "po_amt": float(p_amt), 
                "payable_amt": float(payable_amt_calc), # Update Supabase column
                "wcc_number": wcc_no, "wcc_status": wcc_st
            }
            try:
                supabase.table("nr_calculation").upsert(payload, on_conflict="project_id").execute()
                st.success("✅ Saved!")
                time.sleep(1); st.rerun()
            except Exception as e: st.error(f"Error: {e}")

